# Python bytecode and tool caches
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging output
build/
dist/
*.egg-info/
.eggs/
*.egg

# Editors and operating-system metadata
.idea/
.vscode/
.vs/
.DS_Store
Thumbs.db

# SugarPrep local runtime and generated data
# Clean-break migration source is never publishable.
/_migration/
/manifests/
/models/
/unsloth_compiled_cache/
/DataSets/
/out/
/reports/
/runs/
/deployment/bundles/

# Large model, executable, and transfer artifacts
*.zip
*.7z
*.tar
*.tar.gz
*.exe
*.dll
*.so
*.dylib
*.gguf
*.safetensors
*.pt
*.pth
*.onnx

# Generated local data and evaluation artifacts
*.jsonl
*.parquet
